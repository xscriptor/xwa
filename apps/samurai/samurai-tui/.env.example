# Database backend: sqlite (default) or postgres
SAMURAI_DB_BACKEND=sqlite

# SQLite file path
SAMURAI_SQLITE_PATH=samurai.db

# PostgreSQL connection (only used if SAMURAI_DB_BACKEND=postgres)
DB_HOST=localhost
DB_NAME=samurai
DB_USER=postgres
DB_PASS=postgres

# Log level: debug, info, warn, error
RUST_LOG=info
